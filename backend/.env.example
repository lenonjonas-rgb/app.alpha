PORT=8080
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=CHAVE-PUBLICAVEL
# Segredo SOMENTE no backend privado. Obrigatorio para aprovar cancelamentos/retencoes.
# Nunca use prefixo VITE_ nem inclua no frontend/backup.
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=https://SEU-FRONTEND.vercel.app
DATA_DIR=./data
# Base64 de exatamente 32 bytes aleatorios. Apenas no ambiente privado do backend.
CERTIFICATE_MASTER_KEY=
SCHEMA_DIR=./schemas
# Producao permanece bloqueada ate concluir homologacao.
ALLOW_PRODUCTION=false
